# Backup files de refactors locales — nunca deben commitearse.
*.backup-*
*.bak

# Config local de Claude Code (no aplica a otros developers).
/.claude

# Cache generado por Scribe (se regenera con `php artisan scribe:generate`).
/.scribe

# Archivos de debug/probe ad-hoc.
/storage/probe_*.txt

# Fonts cacheadas por Dompdf — se regeneran solas desde vendor/dompdf/dompdf/lib/fonts/
# la primera vez que se renderiza un PDF. No commitearlas.
/storage/fonts
__pycache__/

# Entorno local de verificación de la fase 0
/vendor
/node_modules
/public/build
/.env

# ── Volcados de la base del sistema viejo con DATOS REALES ──────────────
# El repo es PUBLICO. La base del laboratorio trae nombres de clientes,
# documentos de identidad, direcciones y —en la tabla `users` del sistema
# Rails— la columna `real_password`, que guarda la contraseña EN TEXTO PLANO.
# Nada de eso puede entrar a git: el historial no se borra.
#
# Lo unico versionado de la base vieja es el volcado de ESTRUCTURA
# (docs/migracion/esquema/lab_app_development-estructura.sql), que es
# `--no-data` y no contiene una sola fila.
docs/migracion/esquema/*_completa.sql
docs/migracion/esquema/*_completo.sql
docs/migracion/esquema/*-datos.sql
docs/migracion/esquema/labo_original*.sql
docs/migracion/esquema/ori_aplicados.sql
*.dump
*.sql.gz
*.sql.zip

# OJO con database/seeders/data/legacy/: los volcados con datos del sistema
# viejo SI se versionan (decision del dueno del 2026-08-04; el criterio completo
# esta en la cabecera de docs/migracion/esquema/catalogos-definiciones.sql).
# Es lo que hace reproducible la migracion desde un clon limpio.
# Lo que NO entra ahi es el volcado de `users`: su columna real_password guarda
# la contrasena en texto plano, y eso es una credencial, no un dato de negocio.
/database/seeders/data/legacy/users*.sql

# Los logotipos del sistema viejo (marca de la empresa y sello del organismo
# acreditador) que usa `php artisan report:compare` para reproducir el papel
# anterior. NO se versionan: este repositorio es público, y ni una marca
# registrada ni un sello de acreditación tienen por qué estar en él. Se copian
# a mano desde los assets del sistema Ruby; el comando dice cómo si faltan.
/storage/app/legacy-assets
