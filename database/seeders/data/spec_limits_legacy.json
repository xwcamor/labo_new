  "anomalias": [
    {
      "id": "DIVERGENCIA-1",
      "gravedad": "alta",
      "grupo": "cromas",
      "que": "Los límites de cromas cambian según si el informe se guardó una o dos veces.",
      "detalle": "Al CREAR (rem_report_detail.rb:447) la condición es tipo ∈ {1,2,3,4,5,13}; al ACTUALIZAR (rem_report.rb:517) es tipo < 10 o 13. Los tipos 6 (instrumento), 7 (bushing) y 8 (cables) con aceite mineral caen al else en la creación (todo \"-\") y reciben sus valores reales en el primer reguardado.",
      "inocuo_en": "tipo 9 (interruptor): su cuadro es todo \"-\" de todos modos",
      "decision": "El cuadro por tipo es el correcto: existe y tiene valores. La creación estaba incompleta."
    },
    {
      "id": "DIVERGENCIA-2",
      "gravedad": "media",
      "grupo": "ambos",
      "que": "Los aceites 6 (girasol) y 9 no reciben norma al crear el informe.",
      "detalle": "save_default_values cubre aceites {1,2,3,8}, {4}, {7}, {5}; refresh_orientation_fiqui_values cubre {1,2,3,8}, {4}, {7}, {5,6,9}. Un informe de girasol recién creado imprime \"-\" como norma; guardado dos veces imprime IEC 610203-2025."
    },
    {
      "id": "C2H2-VOLTAJE",
      "gravedad": "baja",
      "grupo": "cromas",
      "que": "En \"De voltaje · Mineral\" el acetileno dice \"16\", sin \"máximo\".",
      "detalle": "El parser del sistema viejo lo lee igual como número, pero el informe imprime \"16\" pelado. Confirmar si es 16 máximo."
    },
    {
      "id": "HORNO-REVISAR",
      "gravedad": "media",
      "grupo": "cromas",
      "que": "El propio código marca el cuadro de horno mineral con \"#####REVISAR **\"."
    },
    {
      "id": "ACEITES-SIN-CUADRO",
      "gravedad": "alta",
      "grupo": "ambos",
      "que": "Los aceites 2, 3, 8 y 9 reciben norma pero no tienen cuadro de límites propio.",
      "detalle": "Se les asigna la norma de mineral (o de vegetal para el 9) pero ninguna rama de tipo de aceite los captura, así que caen al else y salen todos \"-\". Hay que decidir si son alias o fluidos distintos."
    },
    {
      "id": "ESTER-SINTETICO",
      "gravedad": "media",
      "grupo": "fiquis",
      "que": "El aceite 7 se trata de dos formas contradictorias.",
      "detalle": "En fiquis comparte cuadro con el vegetal (oil == 5 or 7); en cromas tiene cuadro propio (\"Midel\"). Uno de los dos está mal."
    },
    {
      "id": "IEC-610203",
      "gravedad": "media",
      "grupo": "ambos",
      "que": "\"IEC 610203-2025\" no es un número de norma IEC válido.",
      "detalle": "Probablemente IEC 61203 o IEC 62770. Se está imprimiendo en informes firmados."
    },
    {
      "id": "RIG-GAP",
      "gravedad": "alta",
      "grupo": "fiquis",
      "que": "Los límites de rigidez no registran la separación de electrodos.",
      "detalle": "rig (40/47/50 kV) y rigep (\"electrodos planos\") se tratan como parámetros distintos. D877 es 2.54 mm fijo; D1816 admite 1.0 o 2.0 mm y los kV no son comparables. Sin el gap no se puede saber contra qué norma se juzgó."
    }
  ],
